# --- Required ---
DISCORD_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017/onyx
IS_LOCAL=false

# --- Optional ---
# Register slash commands to ONE server instantly (handy while testing).
# Leave empty to register globally.
DEV_GUILD_ID=

# Submission deadline used the first time a server is set up (ISO 8601 with offset).
# Default = Nov 12, 2026 12:00 NN Philippine time. Facilitators can change it later with /onyx deadline.
EVENT_DEADLINE=2026-11-12T12:00:00+08:00

# Also log deleted/edited messages (needs the privileged "Message Content" intent enabled in the developer portal).
ENABLE_MESSAGE_LOGS=false

# Optional banner image (direct https URL) shown at the top of the welcome panel.
EVENT_BANNER_URL=
